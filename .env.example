# API Configuration
# ⚠️ REQUIRED: Generate a secure token using: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_TOKEN=CHANGE_THIS_REQUIRED
BASE_URL=http://localhost:8000

# Admin Panel URL (use a random string for security)
# ⚠️ SECURITY: Generate random path with: python -c "import secrets; print('/admin-' + secrets.token_urlsafe(16))"
# DO NOT use predictable paths like /admin, /admin-panel, or names!
ADMIN_URL=CHANGE_THIS_REQUIRED

# JWT Configuration
# ⚠️ CRITICAL: Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This MUST be set and kept secret! Application will not start without it.
JWT_SECRET_KEY=CHANGE_THIS_REQUIRED
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sensors_db
POSTGRES_USER=sensorsuser
# ⚠️ SECURITY: Use a strong password (minimum 16 characters, mix of letters, numbers, symbols)
POSTGRES_PASSWORD=CHANGE_THIS_REQUIRED

# Optional: Override automatic connection strings
# DATABASE_URL_ASYNC=postgresql+asyncpg://sensorsuser:strongpassword@localhost:5432/sensors_db
# DATABASE_URL_SYNC=postgresql://sensorsuser:strongpassword@localhost:5432/sensors_db

# Redis Configuration
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_USE_SSL=0
# ⚠️ SECURITY: ALWAYS set a strong Redis password in production!
REDIS_CACHE_PASSWORD=CHANGE_THIS_REQUIRED
REDIS_CACHE_DB=0
# REDIS_CACHE_URL=redis://localhost:6379/0

# Logging Configuration
# Levels: CRITICAL=50, ERROR=40, WARNING=30, INFO=20, DEBUG=10
LOG_LEVEL=20
SQL_LOG_LEVEL=30

# Database File (for SQLite - not used with PostgreSQL)
DB_NAME=sensors_db.db

# ⚠️ SECURITY CHECKLIST BEFORE DEPLOYING:
# [ ] All passwords are strong (16+ characters, random)
# [ ] JWT_SECRET_KEY is set to a secure random value
# [ ] ADMIN_URL is set to a random, non-guessable path
# [ ] Redis password is set
# [ ] .env file is added to .gitignore (NEVER commit this file!)
# [ ] Changed all default credentials
# [ ] Reviewed CORS settings in app/main.py
# [ ] Enabled HTTPS/TLS for production
# [ ] Configured firewall rules
# [ ] Regular security updates scheduled

