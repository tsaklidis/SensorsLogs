# API Configuration
APP_API_TOKEN=CHANGE_THIS_REQUIRED
BASE_URL=http://localhost:8000

# Admin Panel URL (use a random string for security)
# DO NOT use predictable paths like /admin, /admin-panel, or names!
ADMIN_URL=CHANGE_THIS_REQUIRED

# JWT Configuration
# This MUST be set and kept secret! Application will not start without it.
JWT_SECRET_KEY=CHANGE_THIS_REQUIRED
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sensors_db
POSTGRES_USER=sensorsuser

POSTGRES_PASSWORD=CHANGE_THIS_REQUIRED

# Optional: Override automatic connection strings
# DATABASE_URL_ASYNC=postgresql+asyncpg://sensorsuser:strongpassword@localhost:5432/sensors_db
# DATABASE_URL_SYNC=postgresql://sensorsuser:strongpassword@localhost:5432/sensors_db

# Redis Configuration
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_USE_SSL=0

REDIS_CACHE_PASSWORD=CHANGE_THIS_REQUIRED
REDIS_CACHE_DB=0

# Logging Configuration
# Levels: CRITICAL=50, ERROR=40, WARNING=30, INFO=20, DEBUG=10
LOG_LEVEL=20
SQL_LOG_LEVEL=30

# Database File (for SQLite - not used with PostgreSQL)
DB_NAME=sensors_db.db

